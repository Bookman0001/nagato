{
  "name": "sirius-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "run-p dev:*",
    "dev:next": "next dev",
    "dev:path": "pathpida --enableStatic --ignorePath .gitignore --watch",
    "build": "pathpida --enableStatic --ignorePath .gitignore && next build",
    "lint": "eslint './**/*.ts{,x}'",
    "lint:fix": "eslint './**/*.ts{,x}' --fix",
    "prettier": "prettier --check ./**/*.{ts,tsx}",
    "format": "prettier --write ./**/*.{ts,tsx}",
    "tsc": "tsc --noEmit",
    "knip": "knip --config knip.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@vercel/speed-insights": "2.0.0",
    "dayjs": "1.11.23",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "sanitize-html": "2.18.0",
    "swr": "2.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.24.6",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/eslint-plugin": "1.6.27",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "knip": "6.39.0",
    "lefthook": "2.1.17",
    "mockdate": "3.0.5",
    "msw": "2.15.0",
    "next-router-mock": "1.0.5",
    "next-test-api-route-handler": "5.0.7",
    "npm-run-all2": "9.0.3",
    "pathpida": "0.28.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "undici": "8.11.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
