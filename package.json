{
  "name": "sirius-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "run-p dev:*",
    "dev:next": "next dev",
    "dev:path": "pathpida --enableStatic --ignorePath .gitignore --watch",
    "build": "pathpida --enableStatic --ignorePath .gitignore && next build",
    "lint": "eslint './**/*.ts{,x}'",
    "lint:fix": "eslint './**/*.ts{,x}' --fix",
    "prettier": "prettier --check ./**/*.{ts,tsx}",
    "format": "prettier --write ./**/*.{ts,tsx}",
    "tsc": "tsc --noEmit",
    "knip": "knip --config knip.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@vercel/speed-insights": "2.1.0",
    "dayjs": "1.11.23",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sanitize-html": "2.18.1",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/eslint-plugin": "1.6.28",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "mockdate": "3.0.5",
    "msw": "2.15.0",
    "next-router-mock": "1.0.5",
    "next-test-api-route-handler": "5.0.7",
    "npm-run-all2": "9.0.4",
    "pathpida": "0.28.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "undici": "8.12.4",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
